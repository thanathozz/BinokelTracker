@code {
    [Parameter] public Round        Round        { get; set; } = default!;
    [Parameter] public List<PlayerRef> Players    { get; set; } = new();
    [Parameter] public RuleSet      Rules        { get; set; } = default!;
    [Parameter] public int          RoundIndex   { get; set; }
    [Parameter] public bool         GameFinished { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnEdit   { get; set; }
    [CascadingParameter] public IStrings S { get; set; } = default!;

    private int[] Scores    => Round.CalcScores(Rules);
    private bool  IsSpecial    => Round.Type is RoundType.Durch or RoundType.Bettel;
    private bool  IsAbgegangen => Round.Abgegangen;

    private string StripClass => Round.Type switch
    {
        RoundType.Durch  => "rc-strip-durch",
        RoundType.Bettel => "rc-strip-bettel",
        _                => Round.Won ? "rc-strip-win" : "rc-strip-loss"
    };

    private string TypeTag => Round.Type switch
    {
        RoundType.Durch  => S.TagDurch,
        RoundType.Bettel => S.TagBettel,
        _                => S.TagNormal
    };

    private string TypeTagClass => Round.Type switch
    {
        RoundType.Durch  => "rc-tag-durch",
        RoundType.Bettel => "rc-tag-bettel",
        _                => "rc-tag-normal"
    };

    private string TypeLabel => Round.Type switch
    {
        RoundType.Durch  => "Durch",
        RoundType.Bettel => "Bettel",
        _                => ""
    };

    private string OutcomeTag      => IsAbgegangen ? S.TagFolded : Round.Won ? S.TagWon : S.TagLost;
    private string OutcomeTagClass => Round.Won && !IsAbgegangen ? "rc-tag-win" : "rc-tag-loss";

    private int BidderMeld   => Round.PlayerScores.Count > Round.Bidder ? Round.PlayerScores[Round.Bidder].Meld   : 0;
    private int BidderTricks => Round.PlayerScores.Count > Round.Bidder ? Round.PlayerScores[Round.Bidder].Tricks : 0;

    private ScoreBreakdown[]? _breakdown;
    private ScoreBreakdown[] Breakdown => _breakdown ??= Round.PlayerScores.Count == Players.Count
        ? ScoringCalculator.CalcNormalPreview(
            Round.Bidder, Round.Bid,
            Round.PlayerScores.Select(ps => ps.Abgegangen).ToArray(),
            Round.PlayerScores.Select(ps => ps.Meld).ToArray(),
            Round.PlayerScores.Select(ps => ps.Tricks).ToArray(),
            Rules, Round.LastTrickWinner)
        : Array.Empty<ScoreBreakdown>();
}

<!-- Color strip -->
<div class="rc-strip @StripClass"></div>

<!-- Header: round number + type/outcome tags + action buttons -->
<div class="rc-head">
    <span class="rc-num">@S.RoundPrefix @(RoundIndex + 1)</span>
    <div class="rc-tags">
        <span class="rc-tag @TypeTagClass">@TypeTag</span>
        <span class="rc-tag @OutcomeTagClass">@OutcomeTag</span>
        @if (!IsSpecial) { <span class="rc-tag rc-tag-bid">@Round.Bid</span> }
        <button class="btn" style="padding:2px;color:var(--dark)" @onclick="() => OnEdit.InvokeAsync(RoundIndex)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
        </button>
        <button class="btn" style="padding:2px;color:var(--dark)" @onclick="() => OnDelete.InvokeAsync(RoundIndex)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
            </svg>
        </button>
    </div>
</div>

<!-- Summary sentence -->
<div class="rc-summary">
    <div class="rc-summary-left">
        <span class="rc-bidder-name">@Players[Round.Bidder]</span>@(" ")@if (IsSpecial)
        {
            <span class="rc-summary-text">@(Round.Type == RoundType.Durch ? S.PlaysDurch : S.PlaysBettel) </span><b>@TypeLabel</b>
            <span class="rc-arrow"> · </span>
            <span class="rc-result-text @(Round.Won ? "win" : "loss")">@(Round.Won ? S.WonWord : S.LostWord)</span>
        }
        else if (IsAbgegangen)
        {
            <span class="rc-arrow">@S.Bids</span>@(" ")<span class="rc-bid-val">@Round.Bid</span>
            <span class="rc-arrow"> → </span>
            <span class="rc-result-text loss">@S.FoldedWord</span>
        }
        else if (Round.Won)
        {
            <span class="rc-arrow">@S.Bids</span>@(" ")<span class="rc-bid-val">@Round.Bid</span>
            <span class="rc-arrow"> → </span>
            <span class="rc-result-text win">@(BidderMeld + BidderTricks) @S.Points</span>
        }
        else
        {
            <span class="rc-arrow">@S.Bids</span>@(" ")<span class="rc-bid-val">@Round.Bid</span>
            <span class="rc-arrow"> → </span>
            <span class="rc-result-text loss">@S.NotFulfilled</span>
        }
    </div>
    @{
        var bidderScore = Scores.Length > Round.Bidder ? Scores[Round.Bidder] : 0;
        bool showRight  = IsSpecial
            || IsAbgegangen
            || !Round.Won
            || (Round.LastTrickWinner >= 0 && Round.LastTrickWinner < Players.Count);
    }
    @if (showRight)
    {
        <div class="rc-summary-right">
            @if (IsSpecial)
            {
                <span class="rc-summary-meta-label">@S.SummarySpecialBonusLabel</span>
                <span class="rc-summary-meta-val @(bidderScore >= 0 ? "pos" : "neg")">
                    @(bidderScore > 0 ? $"+{bidderScore}" : bidderScore.ToString())
                </span>
            }
            else if (IsAbgegangen || !Round.Won)
            {
                <span class="rc-summary-meta-label">@S.SummaryBidSaldoLabel</span>
                <span class="rc-summary-meta-val neg">@bidderScore</span>
            }
            else if (Round.LastTrickWinner >= 0 && Round.LastTrickWinner < Players.Count)
            {
                <span class="rc-summary-meta-label">@S.LastTrickBonus</span>
                <span class="rc-summary-meta-val pos">@Players[Round.LastTrickWinner]</span>
            }
        </div>
    }
</div>

<!-- Structured player table -->
<div class="ptable">
    <div class="ptable-head">
        <div class="h-name">@S.ColPlayer</div>
        <div class="h-meld">@S.MeldLabel</div>
        <div class="h-plus"></div>
        <div class="h-stiche">@S.TricksLabel</div>
        <div class="h-mods">@S.ColBoni</div>
        <div class="h-total">@S.ColTotal</div>
    </div>

    @if (Rules.TeamMode && Players.Count == 4)
    {
        for (int ti = 0; ti < 2; ti++)
        {
            int p1 = ti * 2;
            int p2 = ti * 2 + 1;

            var ps1 = Round.PlayerScores.Count > p1 ? Round.PlayerScores[p1] : new PlayerScore();
            var ps2 = Round.PlayerScores.Count > p2 ? Round.PlayerScores[p2] : new PlayerScore();

            int teamMeld = IsSpecial ? 0 : ps1.Meld + ps2.Meld;
            int teamTricks = (IsSpecial) ? 0 : ps1.Tricks + ps2.Tricks;
            
            int s1 = Scores.Length > p1 ? Scores[p1] : 0;
            int s2 = Scores.Length > p2 ? Scores[p2] : 0;
            int teamTotal = s1 + s2;

            bool isBidderTeam = (Round.Bidder == p1 || Round.Bidder == p2);
            
            var bd1 = (!IsSpecial && p1 < Breakdown.Length) ? Breakdown[p1] : null;
            var bd2 = (!IsSpecial && p2 < Breakdown.Length) ? Breakdown[p2] : null;

            bool hasMods = (IsSpecial && isBidderTeam)
                        || (bd1 != null && (bd1.IsLoss || bd1.Bonus > 0 || bd1.LastTrickBonus > 0))
                        || (bd2 != null && (bd2.IsLoss || bd2.Bonus > 0 || bd2.LastTrickBonus > 0));

            <div class="prow @(isBidderTeam ? "bidder" : "") @(ti == 0 ? "team1" : "team2")">
                <div class="pc-name">
                    @if (isBidderTeam)
                    {
                        <svg class="pc-crown" width="13" height="11" viewBox="0 0 20 17" fill="currentColor">
                            <path d="M0 15L2.5 6l4.5 4L10 1l3 9 4.5-4L20 15H0z"/>
                            <rect y="15" width="20" height="2" rx="1"/>
                        </svg>
                    }
                    else
                    {
                        <span class="pc-name-marker"></span>
                    }
                    @Players[p1] & @Players[p2]
                </div>
                <div class="pc-stat @(ps1.Abgegangen && ps2.Abgegangen && !IsSpecial ? "struck" : "")">
                    <span class="stat-num">@teamMeld</span>
                </div>
                <div class="pc-plus">+</div>
                <div class="pc-stat @(IsSpecial ? "empty" : "")">
                    <span class="stat-num">@teamTricks</span>
                </div>
                <div class="pc-mods">
                    @if (IsSpecial && isBidderTeam)
                    {
                        var bonusLbl = Round.Type == RoundType.Durch ? S.ModDurchBonus : S.ModBettelBonus;
                        <span class="mod-pill @(teamTotal >= 0 ? "mod-pos" : "mod-neg")">
                            <span class="mod-label">@bonusLbl</span>
                            <span class="mod-value">@(teamTotal > 0 ? $"+{teamTotal}" : teamTotal.ToString())</span>
                        </span>
                    }
                    @if (bd1 != null && bd1.IsLoss)
                    {
                        <span class="mod-pill mod-neg">
                            <span class="mod-label">@S.BidderFolded</span>
                            <span class="mod-value">-(@Round.Bid)</span>
                        </span>
                    }
                    @if (bd2 != null && bd2.IsLoss)
                    {
                        <span class="mod-pill mod-neg">
                            <span class="mod-label">@S.BidderFolded</span>
                            <span class="mod-value">-(@Round.Bid)</span>
                        </span>
                    }
                    @if (bd1 != null && bd1.Bonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.ModAbgangBonus</span>
                            <span class="mod-value">+@bd1.Bonus</span>
                        </span>
                    }
                    @if (bd2 != null && bd2.Bonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.ModAbgangBonus</span>
                            <span class="mod-value">+@bd2.Bonus</span>
                        </span>
                    }
                    @if (bd1 != null && bd1.LastTrickBonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.LastTrickBonus</span>
                            <span class="mod-value">+@bd1.LastTrickBonus</span>
                        </span>
                    }
                    @if (bd2 != null && bd2.LastTrickBonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.LastTrickBonus</span>
                            <span class="mod-value">+@bd2.LastTrickBonus</span>
                        </span>
                    }
                    @if (!hasMods)
                    {
                        <span class="mod-empty">—</span>
                    }
                </div>
                <div class="pc-total @(teamTotal > 0 ? "pos" : teamTotal < 0 ? "neg" : "zero")">
                    <span class="total-pill">@(teamTotal == 0 ? "±0" : teamTotal > 0 ? $"+{teamTotal}" : teamTotal.ToString())</span>
                </div>
            </div>
        }
    }
    else
    {
        @for (int pi = 0; pi < Players.Count; pi++)
        {
            var pIdx      = pi;
            var isBidder  = pIdx == Round.Bidder;
            var isPartner = Rules.TeamMode && Players.Count == 4 && pIdx == (Round.Bidder ^ 1);
            var delta     = Scores.Length > pIdx ? Scores[pIdx] : 0;
            var bd        = (!IsSpecial && pIdx < Breakdown.Length) ? Breakdown[pIdx] : null;
            var ps        = Round.PlayerScores.Count > pIdx ? Round.PlayerScores[pIdx] : new PlayerScore();

            bool strikeMeld = isBidder && ps.Abgegangen && !IsSpecial;
            int  meldVal    = IsSpecial ? 0 : ps.Meld;
            int  tricksVal  = (IsSpecial || (isBidder && ps.Abgegangen)) ? 0 : ps.Tricks the results a green result, and never characterize incomplete or broken work as done.
            bool dimMeld    = IsSpecial;
            bool dimTricks  = IsSpecial || (isBidder && ps.Abgegangen);

            bool hasMods = (IsSpecial && isBidder)
                        || (bd != null && bd.IsLoss)
                        || (bd != null && bd.Bonus > 0)
                        || (bd != null && bd.LastTrickBonus > 0);
            bool isTeamFirst = Rules.TeamMode && Players.Count == 4 && pIdx % 2 == 0;
            bool isTeamLast  = Rules.TeamMode && Players.Count == 4 && pIdx % 2 == 1;

            <div class="prow @((isBidder || isPartner) ? "bidder" : "") @(Rules.TeamMode && Players.Count == 4 ? (pIdx < 2 ? "team1" : "team2") : "") @(isTeamFirst ? "team-first" : "") @(isTeamLast ? "team-last" : "")">
                <div class="pc-name">
                    @if (isBidder)
                    {
                        <svg class="pc-crown" width="13" height="11" viewBox="0 0 20 17" fill="currentColor">
                            <path d="M0 15L2.5 6l4.5 4L10 1l3 9 4.5-4L20 15H0z"/>
                            <rect y="15" width="20" height="2" rx="1"/>
                        </svg>
                    }
                    else
                    {
                        <span class="pc-name-marker"></span>
                    }
                    @Players[pIdx]
                </div>
                <div class="pc-stat @(strikeMeld ? "struck" : dimMeld ? "empty" : "")">
                    <span class="stat-num">@meldVal</span>
                    @if (strikeMeld) { <span class="stat-sub">@S.MeldDiscarded</span> }
                </div>
                <div class="pc-plus">+</div>
                <div class="pc-stat @(dimTricks ? "empty" : "")">
                    <span class="stat-num">@tricksVal</span>
                </div>
                <div class="pc-mods">
                    @if (IsSpecial && isBidder)
                    {
                        var bonusLbl = Round.Type == RoundType.Durch ? S.ModDurchBonus : S.ModBettelBonus;
                        <span class="mod-pill @(delta >= 0 ? "mod-pos" : "mod-neg")">
                            <span class="mod-label">@bonusLbl</span>
                            <span class="mod-value">@(delta > 0 ? $"+{delta}" : delta.ToString())</span>
                        </span>
                    }
                    else if (bd != null && bd.IsLoss)
                    {
                        var lossLbl   = (!isBidder || bd.IsAbgegangen) ? S.BidderFolded : S.NotFulfilled;
                        var lossValue = Rules.DoubleMinus
                            ? $"-{Round.Bid} × 2"
                            : $"-{Round.Bid}";
                        <span class="mod-pill mod-neg">
                            <span class="mod-label">@lossLbl</span>
                            <span class="mod-value">@lossValue</span>
                        </span>
                    }
                    @if (bd != null && bd.Bonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.ModAbgangBonus</span>
                            <span class="mod-value">+@bd.Bonus</span>
                        </span>
                    }
                    @if (bd != null && bd.LastTrickBonus > 0)
                    {
                        <span class="mod-pill mod-pos">
                            <span class="mod-label">@S.LastTrickBonus</span>
                            <span class="mod-value">+@bd.LastTrickBonus</span>
                        </span>
                    }
                    @if (!hasMods)
                    {
                        <span class="mod-empty">—</span>
                    }
                </div>
                <div class="pc-total @(delta > 0 ? "pos" : delta < 0 ? "neg" : "zero")">
                    <span class="total-pill">@(delta == 0 ? "±0" : delta > 0 ? $"+{delta}" : delta.ToString())</span>
                </div>
            </div>
        }
    }
}
